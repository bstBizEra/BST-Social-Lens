# lens-api runtime config
LENS_DB_DSN=postgresql://lens:lens@lens-db:5432/lens
LENS_API_TOKEN=change-me-to-a-long-random-string
# Origins allowed to call the API from a browser (the Console artifact URL). Comma-separated.
LENS_CORS_ORIGINS=
# lens-db (compose) credentials
POSTGRES_USER=lens
POSTGRES_PASSWORD=lens
POSTGRES_DB=lens
# Retention, ordered (SLL-PROP-DATA-001A D3): raw payload BODIES are nulled after N days (hash + context kept)…
LENS_RAW_RETENTION_DAYS=90
# …then records older than N days (post date, else capture date) are deleted unless protected. 0 disables.
LENS_RECORD_RETENTION_DAYS=730
# Max raw payload body accepted by POST /raw (bytes).
LENS_RAW_MAX_BYTES=2000000

# Phase 6 (001C, C4): symmetric key for encrypting contact raw values (pgcrypto). Unset = store masked + hash only.
LENS_CONTACT_KEY=
# Phase 6 (001C): extraction loop interval in minutes (0 = off; POST /admin/extract still works) and batch size.
LENS_EXTRACT_INTERVAL_MIN=15
LENS_EXTRACT_BATCH=500
# Salt for contact-point hashes (stable per deployment; default derives from LENS_API_TOKEN — set explicitly so token rotation keeps hashes stable).
LENS_CONTACT_SALT=
